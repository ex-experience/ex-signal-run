rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'hussambinhassan92@gmail.com';
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 12 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp)') || request.resource.contentType == 'application/pdf');
    }

    match /creative-intakes/{uid}/{requestId}/{fileName} {
      allow read: if owner(uid) || isAdmin();
      allow write: if owner(uid) && validUpload();
    }

    match /consultations/{uid}/{requestId}/{fileName} {
      allow read: if owner(uid) || isAdmin();
      allow write: if owner(uid) && validUpload();
    }

    match /client-projects/{uid}/{projectId}/{fileName} {
      allow read: if owner(uid) || isAdmin();
      allow write: if isAdmin() && validUpload();
    }

    /* Preserved compatibility path for any existing visual-reference flow. */
    match /visual-consultations/{uid}/{requestId}/{fileName} {
      allow read: if owner(uid) || isAdmin();
      allow write: if owner(uid)
        && request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
